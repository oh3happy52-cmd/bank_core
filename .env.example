# [무엇] 운영 서버용 비밀 값 예시 파일
# [역할] 서버에서 이 파일을 .env로 복사한 뒤 값을 바꿔서 사용 (cp .env.example .env)
#        실제 값이 든 .env는 .gitignore에 있어서 GitHub에 올라가지 않음
# [누가 쓰나] docker-compose.prod.yml이 ${...} 자리에 넣어 읽음

# MySQL 관리자(root) 비밀번호
DB_ROOT_PASSWORD=change-me-root
# 앱이 쓰는 MySQL 계정(bank) 비밀번호
DB_PASSWORD=change-me-bank
# JWT 서명용 비밀 키 (32글자 이상). 서버에서 openssl rand -hex 32 로 만든 값을 넣음
JWT_SECRET=change-me-to-a-random-64-character-hex-string-0123456789abcdef
